{
  "name": "skillhub-local",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Local web app for managing AI agent skills across your PC",
  "type": "module",
  "bin": {
    "skillhub-local": "packages/backend/dist/index.js"
  },
  "files": [
    "packages/backend/dist",
    "packages/frontend/dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm --prefix packages/frontend run dev\" \"npm --prefix packages/backend run dev\"",
    "build": "npm --prefix packages/frontend run build && npm --prefix packages/backend run build",
    "prepublishOnly": "npm run build",
    "start": "npm run build && node packages/backend/dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^10.1.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.3.3",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.8",
    "smol-toml": "^1.7.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/vite": "^4.1.7",
    "@tanstack/react-query": "^5.80.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "zustand": "^5.0.5"
  }
}
